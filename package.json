{
  "name": "@fungi.computer/computer",
  "version": "0.14.5",
  "author": "Levi <levi@technomancy.dev>",
  "description": "Cloudflare Computer host for one durable Fungi Computer",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "import": "./dist/files.js"
    },
    "./backing": {
      "types": "./dist/computer-backends.d.ts",
      "import": "./dist/computer-backends.js"
    },
    "./host-config": {
      "types": "./dist/host-config.d.ts",
      "import": "./dist/host-config.js"
    },
    "./container-policy": {
      "types": "./dist/container-policy.d.ts",
      "import": "./dist/container-policy.js"
    },
    "./fleet/wire": {
      "types": "./dist/fleet/wire.d.ts",
      "import": "./dist/fleet/wire.js"
    },
    "./fleet/inventory-wire": {
      "types": "./dist/fleet/inventory-wire.d.ts",
      "import": "./dist/fleet/inventory-wire.js"
    },
    "./fleet": {
      "types": "./dist/fleet/index.d.ts",
      "import": "./dist/fleet/index.js"
    },
    "./egress": {
      "types": "./dist/egress-policy.d.ts",
      "import": "./dist/egress-policy.js"
    },
    "./port-access": {
      "types": "./dist/port-access.d.ts",
      "import": "./dist/port-access.js"
    }
  },
  "files": [
    "dist",
    "Dockerfile",
    "container",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node scripts/copy-daemon.mjs",
    "build:native": "fungi-apply-patch-build --out native/bin",
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "prepack": "node scripts/assemble-image.mjs",
    "assemble:image": "node scripts/assemble-image.mjs"
  },
  "dependencies": {
    "@fungi.computer/cairn": "0.1.0",
    "@fungi.computer/capnweb": "0.12.0-fungi.0",
    "@fungi.computer/cloudflare-computer": "0.2.1-fungi.2",
    "@fungi.computer/cordyceps": "0.4.3",
    "@fungi.computer/knapsack": "0.4.18",
    "@fungi.computer/seam": "0.2.6",
    "@fungi.computer/watchdog": "0.1.4",
    "@fungi.computer/computer-contract": "0.5.5",
    "effect": "4.0.2",
    "just-bash": "3.4.2",
    "zod": "4.4.3",
    "hono": "4.13.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260828.1",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "oxlint": "1.78.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "uuid": "11.1.1",
    "wrangler": "4.159.0",
    "ws": "8.18.0"
  },
  "botanical": {
    "role": "runtime",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": {
        "status": "not-applicable",
        "reason": "Computer runtime owns no generated API documentation surface"
      },
      "pack": {
        "status": "not-applicable",
        "reason": "Computer runtime is bundled into a container image, not independently packed"
      },
      "smoke": {
        "status": "not-applicable",
        "reason": "The real Worker-runtime test exercises the full container composition"
      },
      "stranger": {
        "status": "not-applicable",
        "reason": "Computer runtime is a container image owner, not an installable library consumer fixture"
      }
    }
  },
  "license": "MIT"
}
